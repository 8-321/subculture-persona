.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .ttl { font-size: 30rpx; font-weight: 800; color: var(--text); }
.navbar .ph { width: 72rpx; }
.navbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; }
.navbtn image { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

.card { margin: 24rpx 40rpx 0; background: var(--card); border-radius: 48rpx; padding: 32rpx;
  box-shadow: var(--shadow-card); }
.sum { display: flex; align-items: center; gap: 24rpx; }
.sum .ic { width: 96rpx; height: 96rpx; border-radius: 28rpx; background: var(--card-2); flex: 0 0 96rpx; padding: 24rpx; box-sizing: border-box; }
.sum .t { font-size: 27rpx; font-weight: 800; color: var(--text); }
.sum .d { font-size: 21rpx; color: var(--text-3); margin-top: 10rpx; }

.rep .hd { display: flex; align-items: baseline; justify-content: space-between; }
.rep .hd .t { font-size: 32rpx; font-weight: 800; color: var(--text); }
.rep .hd .d { font-size: 21rpx; color: var(--text-3); }
.dims { margin-top: 22rpx; }
.dm { margin-bottom: 14rpx; }
.dm .lb { display: flex; justify-content: space-between; font-size: 21rpx; color: var(--text-2); margin-bottom: 8rpx; }
.dm .lb .v { font-weight: 800; color: var(--text); }
.dm .tk { height: 10rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.dm .tk .fill { height: 100%; background: var(--ink); border-radius: 999rpx; }
.rep .ft { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx;
  padding-top: 18rpx; border-top: 1rpx solid var(--line); font-size: 21rpx; color: var(--text-3); }
.rep .ft .go { color: var(--ink); font-weight: 700; }

.empty { padding: 140rpx 40rpx 48rpx; text-align: center; }
.empty .e { font-size: 27rpx; font-weight: 700; color: var(--text-2); }
.empty .s { font-size: 23rpx; color: var(--text-3); margin-top: 16rpx; }
.empty .a { margin: 36rpx auto 0; width: 240rpx; height: 84rpx; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink); font-size: 28rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; }
.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }

/* 举报记录：理由 / 状态 / 撤销 */
.rw { display: flex; align-items: baseline; padding: 6rpx 0; }
.rw .k { width: 88rpx; font-size: 22rpx; font-weight: 700; letter-spacing: .06em; color: var(--text-3); }
.rw .v { flex: 1; font-size: 24rpx; line-height: 1.5; color: var(--text-2); }
.rw .v.warn { color: #B4442E; font-weight: 700; }
.undo { font-size: 23rpx; font-weight: 700; color: var(--text-2); text-decoration: underline; text-underline-offset: 4rpx; }
.note { margin: 20rpx 40rpx 0; font-size: 21rpx; line-height: 1.6; color: var(--text-3); }
