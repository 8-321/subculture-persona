.status-space { width: 100%; }

.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; }
.navbtn image { width: 32rpx; height: 32rpx; }
.qno { font-size: 27rpx; font-weight: 800; color: var(--text); letter-spacing: .4rpx; }
.qno .of { font-weight: 600; color: var(--text-3); }
.timing { font-size: 21rpx; color: var(--text-3); min-width: 140rpx; text-align: right; }

.track { margin: 20rpx 40rpx 0; height: 12rpx; border-radius: 999rpx; background: var(--line); overflow: hidden; }
.track .fill { height: 100%; background: var(--ink); border-radius: 999rpx; transition: width .28s cubic-bezier(.2,.8,.2,1); }

.q { padding: 0 40rpx; margin-top: 32rpx; }
.q .tag { display: inline-flex; align-items: center; gap: 10rpx; height: 48rpx; padding: 0 22rpx;
  border-radius: 999rpx; background: var(--card); border: 1rpx solid var(--line);
  font-size: 21rpx; font-weight: 700; color: var(--text-2); }
.tag-ic { width: 24rpx; height: 24rpx; }
.qt { margin-top: 22rpx; font-size: 42rpx; font-weight: 800; line-height: 1.34; letter-spacing: .4rpx; color: var(--text); }

/* 2 × 2 选项 */
.opts { display: flex; flex-wrap: wrap; padding: 0 40rpx; margin-top: 40rpx; }
.opt { width: 322rpx; margin-right: 26rpx; margin-bottom: 28rpx; }
.opt:nth-child(2n) { margin-right: 0; }
.opt .im { position: relative; width: 322rpx; height: 372rpx; border-radius: 40rpx; overflow: hidden;
  background: var(--card-2); box-shadow: var(--shadow-card); border: 4rpx solid transparent; box-sizing: border-box; }
.opt.on .im { border-color: var(--ink); }
.opt-img { width: 100%; height: 100%; }
.opt-txt { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 0 32rpx; box-sizing: border-box; }
.opt-txt .tt { font-size: 32rpx; font-weight: 800; color: var(--text); text-align: center; line-height: 1.3; }
.opt-txt .ss { font-size: 22rpx; color: var(--text-3); margin-top: 14rpx; text-align: center; }
.opt .no { position: absolute; left: 20rpx; top: 20rpx; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(17,17,20,.55); color: #FFFFFF; font-size: 22rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; }
.opt .check { position: absolute; right: 20rpx; top: 20rpx; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--ink); display: flex; align-items: center; justify-content: center; }
.opt .check image { width: 26rpx; height: 26rpx; }
.check.pop { animation: ck .28s cubic-bezier(.2,1.5,.4,1); }
@keyframes ck { 0% { transform: scale(0); } 62% { transform: scale(1.12); } 100% { transform: scale(1); } }
.opt .st { text-align: center; font-size: 22rpx; font-weight: 700; color: var(--text-3); margin-top: 14rpx; }
.opt.on .st { color: var(--ink); }

.action-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 24rpx;
  padding: 24rpx 40rpx 48rpx; background: var(--card); box-shadow: 0 -8rpx 32rpx rgba(17,17,20,.08); }
.btn-ghost { flex: 1; height: 104rpx; border-radius: 999rpx; border: 2rpx solid var(--line-2);
  color: var(--text-2); font-size: 29rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.btn-ghost image { width: 30rpx; height: 30rpx; }
.btn-main { flex: 1.15; height: 104rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink);
  font-size: 31rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.btn-main image { width: 30rpx; height: 30rpx; }
.disabled { opacity: .38; }
.press { opacity: .88; }
