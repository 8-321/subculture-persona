<view class="pg {{dark ? 'theme-dark' : ''}} {{reduce ? 'reduce-motion' : ''}} {{tr}}">
  <view class="status-space" style="height:{{sbh}}px"></view>

  <view class="navbar capr" style="padding-right:{{capR}}px">
    <view class="navbtn" bindtap="onBack" hover-class="press">
      <image src="/images/ic/back-{{dark ? 'white' : 'ink'}}.png" mode="aspectFit" />
    </view>
    <view class="ttl">浏览历史</view>
    <view class="tx" bindtap="onClear">清空</view>
  </view>

  <view class="list">
    <block wx:for="{{groups}}" wx:key="name">
      <view class="grp" wx:if="{{item.items.length}}">{{item.name}}</view>
      <view class="row" wx:for="{{item.items}}" wx:for-item="it" wx:key="id" bindtap="onOpen" data-id="{{it.id}}" data-type="{{it.type}}">
        <image class="th" src="{{it.img}}" mode="aspectFill" />
        <view class="tx">
          <view class="t">{{it.title}}</view>
          <view class="d">
            <text wx:if="{{it.src}}" class="src">{{it.src}}</text>{{it.timeText}}
          </view>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{total === 0}}" class="empty">
    <view class="e">还没有浏览记录</view>
    <view class="s">看过的内容会出现在这里</view>
  </view>

  <view class="safe-pad"></view>
</view>
<view class="fade-bottom {{dark ? 'dk' : ''}}"></view>
