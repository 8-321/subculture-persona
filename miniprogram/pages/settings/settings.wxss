.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .ttl { font-size: 30rpx; font-weight: 800; color: var(--text); }
.navbar .ph { width: 72rpx; }
.navbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; }
.navbtn image { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

.card { margin: 24rpx 40rpx 0; background: var(--card); border-radius: 48rpx; padding: 32rpx;
  box-shadow: var(--shadow-card); }
.me { display: flex; align-items: center; gap: 24rpx; }
.me .av { width: 112rpx; height: 112rpx; border-radius: 32rpx; background: var(--ink); color: var(--on-ink);
  font-size: 38rpx; font-weight: 800; display: flex; align-items: center; justify-content: center; flex: 0 0 112rpx; }
.me .t { font-size: 30rpx; font-weight: 800; color: var(--text); }
.me .d { font-size: 22rpx; color: var(--text-3); margin-top: 12rpx; }

.grp-card { margin: 24rpx 40rpx 0; background: var(--card); border-radius: 48rpx;
  box-shadow: var(--shadow-card); overflow: hidden; }
.st { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 32rpx;
  border-bottom: 1rpx solid var(--line); }
.st:last-child { border-bottom: none; }
.st .ic { width: 40rpx; height: 40rpx; flex: 0 0 40rpx; opacity: .8; }
.st .t { font-size: 27rpx; font-weight: 700; color: var(--text); }
.st .v { margin-left: auto; font-size: 22rpx; color: var(--text-3); }
.st .go { width: 24rpx; height: 24rpx; margin-left: auto; }
.st.col { display: block; }
.st-row { display: flex; align-items: center; gap: 20rpx; }

.theme { display: flex; gap: 24rpx; margin-top: 24rpx; }
.tp { flex: 1; }
.pv { height: 120rpx; border-radius: 24rpx; background: #F5F5F6; padding: 16rpx; box-sizing: border-box;
  border: 2rpx solid var(--line); display: flex; flex-direction: column; gap: 10rpx; }
.pv.dk { background: #0E0E11; }
.pv .a { height: 32rpx; width: 70%; border-radius: 12rpx; background: #FFFFFF; }
.pv.dk .a { background: #17171B; }
.pv .b { height: 24rpx; width: 46%; border-radius: 12rpx; background: #141418; opacity: .18; }
.pv.dk .b { background: #F5F5F7; }
.cap { text-align: center; font-size: 21rpx; color: var(--text-3); margin-top: 12rpx; }
.cap.on { color: var(--ink); font-weight: 800; }

.sw { width: 88rpx; height: 48rpx; border-radius: 999rpx; background: var(--line-2);
  position: relative; margin-left: auto; flex: 0 0 88rpx; transition: background .2s ease; }
.sw.on { background: var(--ink); }
.sw .knob { position: absolute; left: 6rpx; top: 6rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #FFFFFF; transition: transform .2s ease; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.18); }
.sw.on .knob { transform: translateX(40rpx); }

/* 开关下的说明行：不单独成卡片，视觉上贴着上一个开关 */
.st.sub.split { border-top: 1rpx solid var(--line); margin-top: 4rpx; padding-top: 20rpx; }
.st.sub { padding-top: 0; border-bottom: none; }
.st.sub .t2 {
  font-size: 21rpx; color: var(--text-3); line-height: 1.6;
  padding: 0 0 4rpx 60rpx; margin-top: -8rpx;
}

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }
