.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.nav-title { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 27rpx; font-weight: 700; letter-spacing: 5rpx; }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.share-btn { padding: 0; margin: 0; line-height: 1; }
.share-btn::after { border: none; }
.press { opacity: .82; }

.hero { position: relative; margin: 18rpx 40rpx 0; height: 470rpx; overflow: hidden; background: #111114; border-radius: 28rpx; }
.hero image { width: 100%; height: 100%; }
.hero-sc { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,10,12,.18) 0%, rgba(10,10,12,.06) 34%, rgba(10,10,12,.88) 100%); }
.h-tx { position: absolute; left: 34rpx; right: 34rpx; bottom: 30rpx; }
.h-k { font-size: 19rpx; letter-spacing: 4rpx; color: rgba(255,255,255,.6); }
.h-n { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 62rpx; font-weight: 700;
  letter-spacing: 4rpx; color: #fff; margin-top: 12rpx; line-height: 1.1; }
.h-tag { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 16rpx; }
.h-t { font-size: 20rpx; color: rgba(255,255,255,.82); border: 1rpx solid rgba(255,255,255,.38); border-radius: 999rpx; padding: 6rpx 16rpx; }

.idcard { display: flex; align-items: center; gap: 20rpx; margin: 26rpx 40rpx 0; padding: 26rpx 28rpx;
  background: var(--card); border: 1rpx solid var(--line); border-radius: 32rpx; box-shadow: var(--shadow-card); }
.id-l { flex: 1; min-width: 0; }
.id-d { font-size: 22rpx; color: var(--text-2); line-height: 1.6; }
.id-s { font-size: 19rpx; color: var(--text-3); line-height: 1.6; margin-top: 8rpx; }
.id-demo { display: inline-block; margin-top: 10rpx; padding: 4rpx 12rpx; border-radius: 8rpx;
  background: var(--line-2); color: var(--text-2); font-size: 18rpx; font-weight: 700; }
.fo { flex: 0 0 auto; min-width: 136rpx; height: 72rpx; padding: 0 26rpx; display: flex; align-items: center;
  justify-content: center; background: var(--ink); color: var(--on-ink); font-size: 23rpx; font-weight: 800;
  border-radius: 999rpx; white-space: nowrap; }
.fo.on { background: transparent; color: var(--text); border: 1rpx solid var(--line-2); }

.sect { padding: 0 40rpx; margin-top: 38rpx; }
.sect-h { display: flex; align-items: baseline; justify-content: space-between; }
.sect-t { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 31rpx; font-weight: 700; }
.sect-m { font-size: 19rpx; color: var(--text-3); }
.grid { display: flex; flex-wrap: wrap; gap: 22rpx; margin-top: 18rpx; }
.pd { width: calc((100% - 22rpx) / 2); }
.pd-im { position: relative; height: 360rpx; overflow: hidden; background: var(--card-2); border-radius: 24rpx; }
.pd-im image { width: 100%; height: 100%; }
.pd-nm { font-size: 24rpx; font-weight: 700; margin-top: 12rpx; }
.pd-pc { font-size: 20rpx; color: var(--text-2); margin-top: 6rpx; }
.pd-pc.np { color: var(--text-3); }

.empty { padding: 80rpx 0; text-align: center; }
.empty .e { font-size: 26rpx; font-weight: 700; }
.empty .s { font-size: 20rpx; color: var(--text-3); margin-top: 10rpx; }
.endnote { padding: 34rpx 40rpx 0; font-size: 19rpx; line-height: 1.7; color: var(--text-3); text-align: center; }
.safe-pad { height: 90rpx; }