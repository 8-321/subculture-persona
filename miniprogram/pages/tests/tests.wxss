.status-space { width: 100%; }

.topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.topbar .hl { display: flex; align-items: center; gap: 20rpx; }
.topbar .logo { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; }
.brand { font-size: 30rpx; font-weight: 800; letter-spacing: 2.8rpx; line-height: 1; color: var(--text); }
.pagename { font-size: 21rpx; font-weight: 600; letter-spacing: 5.2rpx; line-height: 1; color: var(--text-3); margin-top: 10rpx; }
.icbtn { width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(17, 17, 17, .05); }
.icbtn .ic-w { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

.cats { margin-top: 24rpx; padding: 0 40rpx 8rpx; white-space: nowrap;
  -webkit-mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%); }
.cat { display: inline-block; height: 68rpx; line-height: 68rpx; padding: 0 30rpx; border-radius: 999rpx;
  background: var(--card); color: var(--text-2); font-size: 26rpx; font-weight: 700; margin-right: 18rpx;
  border: 1rpx solid var(--line); }
.cat.on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }

/* 主推卡：高 176rpx（设计 88px ×2） */
.feat { position: relative; margin: 24rpx 40rpx 0; min-height: 176rpx; border-radius: 40rpx; overflow: hidden;
  box-shadow: var(--shadow-card); }
.feat-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.feat-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(10,10,12,.88) 0%, rgba(10,10,12,.55) 52%, rgba(10,10,12,.20) 100%); }
.feat-tx { position: relative; box-sizing: border-box; min-height: 176rpx; padding: 8rpx 196rpx 8rpx 32rpx;
  display: flex; flex-direction: column; justify-content: center; }
.feat-tx .pill { align-self: flex-start; }
.feat-t { font-size: 30rpx; font-weight: 800; line-height: 1.3; color: #FFFFFF; margin-top: 12rpx; letter-spacing: .4rpx; }
.feat-d { font-size: 20rpx; color: rgba(255,255,255,.72); margin-top: 10rpx; }
.feat-go { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%);
  min-height: 56rpx; height: auto; padding: 6rpx 22rpx; border-radius: 999rpx; background: #FFFFFF; color: #141418;
  font-size: 24rpx; font-weight: 800; line-height: 1.2; display: flex; align-items: center; white-space: nowrap;
  box-shadow: 0 12rpx 32rpx rgba(0,0,0,.22); }

.sec { display: flex; align-items: baseline; justify-content: space-between; padding: 0 40rpx; margin-top: 34rpx; }
.sec .t { font-size: 29rpx; font-weight: 800; letter-spacing: .8rpx; }
.sec .m { font-size: 22rpx; color: var(--text-3); }

.grid { display: flex; flex-wrap: wrap; padding: 0 40rpx; margin-top: 24rpx; }
.tc { width: 322rpx; margin-right: 22rpx; margin-bottom: 32rpx; }
.tc:nth-child(2n) { margin-right: 0; }
.tc-im { position: relative; width: 322rpx; height: 202rpx; border-radius: 28rpx; overflow: hidden;
  background: var(--card-2); box-shadow: var(--shadow-card); }
.tc-im image { width: 100%; height: 100%; }
.tc-n { position: absolute; left: 16rpx; top: 16rpx; height: 34rpx; padding: 0 16rpx; border-radius: 18rpx;
  background: rgba(17,17,20,.62); color: #FFFFFF; font-size: 19rpx; font-weight: 700;
  display: flex; align-items: center; }
.tc-a { font-size: 25rpx; font-weight: 700; line-height: 1.34; margin-top: 16rpx; min-height: 2.68em; color: var(--text); }
.tc-b { font-size: 20rpx; color: var(--text-3); margin-top: 8rpx; }
.tc-demo { position: absolute; right: 14rpx; top: 14rpx; height: 34rpx; padding: 0 14rpx; border-radius: 17rpx;
  background: rgba(17,17,20,.62); color: #FFFFFF; font-size: 18rpx; font-weight: 700;
  display: flex; align-items: center; }

.empty { padding: 140rpx 40rpx; text-align: center; }
.empty .e { font-size: 27rpx; font-weight: 700; color: var(--text-2); }
.empty .s { font-size: 23rpx; color: var(--text-3); margin-top: 16rpx; }

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }

.trail { display: flex; padding: 22rpx 40rpx 4rpx; white-space: nowrap; }
.tg2 { display: inline-flex; flex-direction: column; width: 210rpx; margin-right: 18rpx; flex: 0 0 210rpx; }
.tg2-im { position: relative; width: 210rpx; height: 262rpx; overflow: hidden; border-radius: 16rpx; background: var(--card-2); }
.tg2-im image { width: 100%; height: 100%; }
.tg2-no { position: absolute; left: 12rpx; top: 12rpx; font-size: 18rpx; letter-spacing: 2rpx;
  color: rgba(255,255,255,.74); }
.tg2-n { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 27rpx; font-weight: 700; margin-top: 12rpx; }
.tg2-k { font-size: 19rpx; color: var(--text-3); margin-top: 4rpx; }
.press { opacity: .82; }