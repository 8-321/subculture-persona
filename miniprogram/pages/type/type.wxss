.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.nav-title { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 27rpx; font-weight: 700; letter-spacing: 5rpx; }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.share-btn { padding: 0; margin: 0; line-height: 1; }
.share-btn::after { border: none; }
.press { opacity: .82; }

.hero { position: relative; margin: 18rpx 40rpx 0; height: 660rpx; border-radius: 40rpx; overflow: hidden; background: #111114; }
.hero image { width: 100%; height: 100%; }
.hero-sc { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,10,12,.24) 0%, rgba(10,10,12,.06) 36%, rgba(10,10,12,.88) 100%); }
.arch { position: absolute; left: 34rpx; top: 30rpx; display: flex; align-items: center; gap: 14rpx; }
.arch-k { font-size: 20rpx; letter-spacing: 5rpx; color: rgba(255,255,255,.72); }
.mine { font-size: 19rpx; padding: 6rpx 14rpx; border: 1rpx solid rgba(255,255,255,.46); color: #fff; letter-spacing: 1rpx; }
.hero-tx { position: absolute; left: 40rpx; right: 40rpx; bottom: 38rpx; }
.hero-tx .eb { font-size: 20rpx; letter-spacing: 4rpx; color: rgba(255,255,255,.58); }
.hero-tx .nm { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 80rpx; font-weight: 700;
  letter-spacing: 5rpx; color: #fff; margin-top: 16rpx; line-height: 1.06; }
.hero-tx .nick { font-size: 24rpx; color: rgba(255,255,255,.86); margin-top: 14rpx; }
.hero-tx .tag { font-size: 24rpx; line-height: 1.66; color: rgba(255,255,255,.72); margin-top: 16rpx; max-width: 540rpx; }

.quote { padding: 0 64rpx; margin-top: 36rpx; font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  text-align: center; font-size: 32rpx; line-height: 1.8; font-weight: 600; }

.card { margin: 34rpx 40rpx 0; padding: 30rpx 32rpx; background: var(--card);
  border: 1rpx solid var(--line); border-radius: 30rpx; }
.card .hd { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 16rpx; }
.card .hd .t { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.card .hd .m { font-size: 19rpx; color: var(--text-3); }

.dim { padding: 18rpx 0 16rpx; border-bottom: 1rpx solid var(--line); }
.dim:last-child { border-bottom: none; padding-bottom: 2rpx; }
.dim-top { display: flex; align-items: baseline; }
.dim-n { font-size: 24rpx; font-weight: 700; }
.dim-v { margin-left: auto; font-size: 25rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.dim-bar { height: 5rpx; background: var(--line); margin-top: 12rpx; overflow: hidden; }
.dim-fill { height: 100%; background: var(--ink); }

.note { margin: 28rpx 40rpx 0; padding: 26rpx 30rpx; border-radius: 32rpx; background: var(--ink); color: var(--on-ink); }
.note-k { font-size: 19rpx; letter-spacing: 5rpx; opacity: .58; }
.note-t { font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 27rpx; line-height: 1.7; margin-top: 12rpx; }

.why .li { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 16rpx; }
.why .li .dt { width: 10rpx; height: 10rpx; background: var(--ink); margin-top: 14rpx; flex: 0 0 10rpx; }
.why .li text { font-size: 25rpx; line-height: 1.62; color: var(--text-2); flex: 1; }

.origin { background: var(--card-2); }
.org-line { font-size: 21rpx; letter-spacing: 2rpx; color: var(--text-3); }
.org-ev { font-size: 25rpx; line-height: 1.78; margin-top: 12rpx; }
.org-k { font-size: 19rpx; letter-spacing: 4rpx; color: var(--text-3); margin-top: 26rpx; }
.fact { padding: 18rpx 0; border-top: 1rpx solid var(--line); margin-top: 4rpx; }
.fact-t { font-size: 24rpx; line-height: 1.72; color: var(--text); }
.fact-s { font-size: 20rpx; color: var(--text-3); margin-top: 8rpx; }

.markers { padding: 30rpx 40rpx 0; }
.markers-k { font-size: 19rpx; letter-spacing: 5rpx; color: var(--text-3); }
.markers-l { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 14rpx; }
.mk { padding: 10rpx 18rpx; border: 1rpx solid var(--line-2); font-size: 22rpx; color: var(--text); }

.kin { display: flex; gap: 18rpx; padding: 0 40rpx; margin-top: 30rpx; }
.kin-card { position: relative; flex: 1; height: 290rpx; overflow: hidden; background: #111114; }
.kin-card image { width: 100%; height: 100%; }
.kin-sc { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,10,12,.04) 26%, rgba(10,10,12,.9) 100%); }
.kin-tx { position: absolute; left: 20rpx; right: 16rpx; bottom: 18rpx; }
.kin-k { font-size: 18rpx; letter-spacing: 4rpx; color: rgba(255,255,255,.58); }
.kin-n { font-size: 25rpx; font-weight: 700; color: #fff; margin-top: 8rpx; }

.h2 { padding: 0 40rpx; margin-top: 42rpx; font-family: "Songti SC", "STSong", "Noto Serif SC", serif;
  font-size: 31rpx; font-weight: 700; letter-spacing: 1rpx; }
.tlist { padding: 0 40rpx; margin-top: 18rpx; }
.tr { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.tr-im { width: 112rpx; height: 112rpx; flex: 0 0 112rpx; border-radius: 14rpx; background: var(--card-2); }
.tr-tx { flex: 1; min-width: 0; }
.tr-t { font-size: 25rpx; font-weight: 700; }
.tr-d { font-size: 20rpx; color: var(--text-3); margin-top: 8rpx; }
.tr-go { width: 24rpx; height: 24rpx; }

.mini { display: flex; gap: 24rpx; padding: 0 40rpx; margin-top: 20rpx; }
.mi { flex: 1; min-width: 0; }
.mi-im { position: relative; height: 310rpx; overflow: hidden; border-radius: 20rpx; background: var(--card-2); }
.mi-im image { width: 100%; height: 100%; }
.mi-bd { font-size: 20rpx; color: var(--text-3); margin-top: 12rpx; }
.mi-nm { font-size: 24rpx; font-weight: 700; margin-top: 6rpx; }
.mi-pc { font-size: 20rpx; color: var(--text-3); margin-top: 6rpx; }

.xlist { padding: 0 40rpx; margin-top: 16rpx; }
.xr { display: flex; align-items: center; gap: 20rpx; padding: 18rpx 0; border-bottom: 1rpx solid var(--line); }
.xr .th { width: 104rpx; height: 104rpx; flex: 0 0 104rpx; border-radius: 14rpx; background: var(--card-2); }
.xr .xt { flex: 1; min-width: 0; }
.xr .xt .t { font-size: 24rpx; font-weight: 700; }
.xr .xt .d { font-size: 20rpx; color: var(--text-3); margin-top: 8rpx; }
.xr .go { width: 24rpx; height: 24rpx; }

.endnote { padding: 32rpx 40rpx 0; text-align: center; font-size: 20rpx; color: var(--text-3); }
.safe-pad { height: 230rpx; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background: var(--card);
  border-top: 1rpx solid var(--line); z-index: 20; }
.cbtn { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; border-radius: 50%; background: var(--card-2);
  border: 1rpx solid var(--line); display: flex; align-items: center; justify-content: center; }
.cbtn.on { border-color: var(--ink); }
.cbtn image { width: 36rpx; height: 36rpx; }
.btn { flex: 1; height: 96rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink); font-size: 29rpx;
  font-weight: 800; letter-spacing: 1rpx; display: flex; align-items: center; justify-content: center; }
.sbtn { width: 96rpx; height: 96rpx; flex: 0 0 96rpx; padding: 0; margin: 0; background: transparent;
  border: 1rpx solid var(--line-2); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.sbtn::after { border: none; }
.sbtn image { width: 32rpx; height: 32rpx; }