.status-space { width: 100%; }

.sbar { display: flex; align-items: center; gap: 14rpx; margin: 24rpx 40rpx 0; min-height: 88rpx;
  padding: 0 24rpx; border-radius: 999rpx; background: var(--card); border: 1rpx solid var(--line); }
.s-ic { width: 30rpx; height: 30rpx; flex: 0 0 30rpx; }
.inp { flex: 1; min-width: 0; font-size: 27rpx; color: var(--text); height: 88rpx; }
.phc { color: var(--text-3); }
.clr { width: 40rpx; height: 40rpx; display: flex; align-items: center; justify-content: center; }
.clr image { width: 26rpx; height: 26rpx; }
.cancel { flex: 0 0 auto; white-space: nowrap; line-height: 1.3; font-size: 25rpx; color: var(--text-2); font-weight: 700; }

.block { padding: 0 40rpx; margin-top: 32rpx; }
.bh { display: flex; align-items: center; justify-content: space-between; }
.bt { font-size: 27rpx; font-weight: 800; }
.cl { font-size: 22rpx; color: var(--text-3); }
.hw { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 20rpx; }
.w { flex: 0 0 auto; white-space: nowrap; height: auto; min-height: 60rpx; padding: 6rpx 26rpx;
  border-radius: 999rpx; background: var(--card); line-height: 1.3;
  border: 1rpx solid var(--line); font-size: 23rpx; color: var(--text-2);
  display: flex; align-items: center; }
.none { font-size: 23rpx; color: var(--text-3); margin-top: 20rpx; }

.sug { padding: 0 40rpx; margin-top: 20rpx; }
.sg { display: flex; align-items: center; gap: 16rpx; height: 88rpx; border-bottom: 1rpx solid var(--line);
  font-size: 26rpx; color: var(--text); }
.sg-ic { width: 26rpx; height: 26rpx; opacity: .5; }

.chips { display: flex; flex-wrap: wrap; align-items: center; gap: 12rpx 14rpx; padding: 0 40rpx; margin-top: 28rpx; }
.c { flex: 0 0 auto; white-space: nowrap; height: auto; min-height: 60rpx; padding: 6rpx 24rpx;
  border-radius: 999rpx; background: var(--card); line-height: 1.3;
  border: 1rpx solid var(--line); color: var(--text-2); font-size: 23rpx; font-weight: 700;
  display: flex; align-items: center; }
.c.on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }
.c.fl { margin-left: auto; }
.c.fl.has { border-color: var(--ink); font-weight: 800; }
.c.fl.press { transform: scale(.94); }
.c.fl image { width: 22rpx; height: 22rpx; }
.c-n {
  min-width: 28rpx; height: 28rpx; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink);
  font-size: 18rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; padding: 0 8rpx;
}

/* 已选条件条 */
.chosen { display: flex; gap: 14rpx; padding: 20rpx 40rpx 0; overflow-x: auto; white-space: nowrap; }
.chosen::-webkit-scrollbar { display: none; }
.ci {
  flex: 0 0 auto;
  display: inline-flex; align-items: center; gap: 10rpx;
  height: 56rpx; padding: 0 20rpx; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink);
  font-size: 22rpx; font-weight: 700;
}
.ci-x { width: 20rpx; height: 20rpx; opacity: .85; }
.ci.cl { background: transparent; color: var(--text-3); border: 1rpx solid var(--line-2); }

.rows { padding: 0 40rpx; margin-top: 24rpx; }
.row { display: flex; align-items: center; gap: 22rpx; height: 148rpx;
  background: var(--card); border-radius: 32rpx; padding: 0 24rpx; margin-bottom: 18rpx;
  box-shadow: var(--shadow-card); }
.row .ic { width: 104rpx; height: 104rpx; border-radius: 28rpx; flex: 0 0 104rpx; background: var(--card-2); }
.rtx { flex: 1; min-width: 0; }
.rtx .t { font-size: 26rpx; font-weight: 700; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rtx .d { font-size: 21rpx; color: var(--text-3); margin-top: 10rpx; }

.empty { padding: 140rpx 40rpx; text-align: center; }
.empty .e { font-size: 27rpx; font-weight: 700; color: var(--text-2); }
.empty .s { font-size: 23rpx; color: var(--text-3); margin-top: 16rpx; }

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }

.np { font-size: 22rpx; font-weight: 600; color: var(--text-3); }
