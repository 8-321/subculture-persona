.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.rt { font-size: 24rpx; color: var(--text-3); padding: 18rpx 4rpx 18rpx 20rpx; }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.press { opacity: .82; }

.head { padding: 40rpx 40rpx 0; }
.kick { font-size: 20rpx; letter-spacing: 4rpx; color: var(--text-3); }
.big { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 56rpx; font-weight: 700;
  letter-spacing: 2rpx; margin-top: 14rpx; line-height: 1.25; }
.sub { font-size: 23rpx; line-height: 1.72; color: var(--text-2); margin-top: 18rpx; }

.ava-wrap { display: flex; align-items: center; gap: 24rpx; padding: 40rpx 40rpx 0; }
.ava { width: 144rpx; height: 144rpx; padding: 0; margin: 0; border-radius: 50%; overflow: hidden;
  background: var(--card-2); border: 1rpx solid var(--line-2); flex: 0 0 144rpx; }
.ava::after { border: none; }
.ava-img { width: 100%; height: 100%; }
.ava-ph { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6rpx; }
.ava-ph text { font-size: 19rpx; color: var(--text-3); }
.ava-ic { width: 30rpx; height: 30rpx; }
.ava-note { font-size: 20rpx; color: var(--text-3); line-height: 1.6; }

.form { margin: 34rpx 40rpx 0; padding: 26rpx 26rpx 20rpx; background: var(--card); border: 1rpx solid var(--line); border-radius: 32rpx; }
.label { font-size: 20rpx; letter-spacing: 3rpx; color: var(--text-3); }
.input { width: 100%; height: 74rpx; font-size: 32rpx; font-weight: 700; color: var(--text); }
.phc { color: var(--text-3); font-weight: 400; }
.counter { text-align: right; font-size: 19rpx; color: var(--text-3); }

.agree { display: flex; align-items: flex-start; gap: 14rpx; padding: 30rpx 40rpx 0; }
.ck { width: 36rpx; height: 36rpx; flex: 0 0 36rpx; border: 1rpx solid var(--line-2); margin-top: 2rpx;
  display: flex; align-items: center; justify-content: center; }
.ck.on { background: var(--ink); border-color: var(--ink); }
.ck image { width: 22rpx; height: 22rpx; }
.at { flex: 1; font-size: 21rpx; line-height: 1.7; color: var(--text-3); }
.lnk { color: var(--text); text-decoration: underline; }

.err { padding: 18rpx 40rpx 0; font-size: 22rpx; color: #B3261E; }
.cta { margin: 36rpx 40rpx 0; height: 100rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink);
  font-size: 31rpx; font-weight: 800; letter-spacing: 2rpx; display: flex; align-items: center; justify-content: center; }
.cta.off { opacity: .38; }
.fine { padding: 24rpx 40rpx 0; font-size: 19rpx; line-height: 1.7; color: var(--text-3); text-align: center; }
.safe-pad { height: 120rpx; }