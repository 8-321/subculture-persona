.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.ttl { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 27rpx; font-weight: 700; letter-spacing: 5rpx; }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.ph { width: 76rpx; height: 76rpx; }
.press { opacity: .82; }

.hero { margin: 18rpx 40rpx 0; padding: 46rpx 36rpx 42rpx; border-radius: 36rpx; background: #141418; color: #fff; }
.kick { font-size: 19rpx; letter-spacing: 5rpx; color: rgba(255,255,255,.54); }
.big { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 48rpx; font-weight: 700;
  line-height: 1.35; margin-top: 18rpx; letter-spacing: 2rpx; }
.sub { font-size: 22rpx; line-height: 1.7; color: rgba(255,255,255,.64); margin-top: 22rpx; }

.offers { padding: 0 40rpx; }
.of { margin-top: 28rpx; padding: 30rpx 30rpx 26rpx; border-radius: 32rpx; background: var(--card); border: 1rpx solid var(--line); box-shadow: var(--shadow-card); }
.of-top { display: flex; align-items: baseline; gap: 16rpx; }
.of-no { font-size: 19rpx; color: var(--text-3); letter-spacing: 2rpx; }
.of-t { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 34rpx; font-weight: 700; letter-spacing: 1rpx; }
.of-d { font-size: 23rpx; line-height: 1.65; color: var(--text-2); margin-top: 14rpx; }
.of-li { display: flex; align-items: flex-start; gap: 12rpx; margin-top: 14rpx; }
.of-li .dot { width: 8rpx; height: 8rpx; background: var(--ink); margin-top: 13rpx; flex: 0 0 8rpx; }
.of-li text { font-size: 22rpx; line-height: 1.6; color: var(--text-2); }
.of-meta { display: flex; align-items: baseline; justify-content: space-between; margin-top: 26rpx;
  padding-top: 20rpx; border-top: 1rpx solid var(--line); font-size: 25rpx; font-weight: 800; }
.of-time { font-size: 20rpx; font-weight: 400; color: var(--text-3); }
.price-note { font-size: 19rpx; color: var(--text-3); margin-top: 18rpx; line-height: 1.6; text-wrap: pretty; }

.sect { padding: 44rpx 40rpx 0; }
.sect-t { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 33rpx; font-weight: 700; letter-spacing: 1rpx; }

.step { display: flex; gap: 20rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.step-n { font-size: 19rpx; color: var(--text-3); letter-spacing: 2rpx; padding-top: 4rpx; flex: 0 0 48rpx; }
.step-x { flex: 1; }
.step-t { font-size: 25rpx; font-weight: 800; }
.step-d { font-size: 22rpx; line-height: 1.68; color: var(--text-2); margin-top: 8rpx; }

.why { display: flex; gap: 16rpx; margin-top: 22rpx; }
.w { flex: 1; padding: 24rpx 20rpx; border-radius: 28rpx; background: var(--card); border: 1rpx solid var(--line); }
.w-n { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 30rpx; font-weight: 700; }
.w-t { font-size: 20rpx; line-height: 1.65; color: var(--text-2); margin-top: 12rpx; }

.no { margin-top: 18rpx; }
.no-li { font-size: 22rpx; line-height: 1.8; color: var(--text-2); padding-left: 18rpx; position: relative; }
.no-li::before { content: '—'; position: absolute; left: 0; color: var(--text-3); }

.contact { margin: 44rpx 40rpx 0; padding: 34rpx 30rpx; border-radius: 28rpx; background: var(--card-2); border-left: 6rpx solid var(--ink); }
.c-k { font-size: 19rpx; letter-spacing: 5rpx; color: var(--text-3); }
.c-t { font-size: 24rpx; line-height: 1.7; margin-top: 12rpx; }
.c-mail { font-size: 30rpx; font-weight: 800; margin-top: 18rpx; text-decoration: underline; }
.c-mail.off { font-size: 24rpx; font-weight: 700; color: var(--text-3); text-decoration: none; }
.c-ops { display: flex; gap: 14rpx; margin-top: 26rpx; }
.c-btn { flex: 1; height: 86rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink); font-size: 24rpx; font-weight: 700; padding: 0; margin: 0; line-height: 1; }
.c-btn.ghost { background: transparent; color: var(--text); border: 1rpx solid var(--line-2); }
.c-btn::after { border: none; }
.c-fine { font-size: 18rpx; color: var(--text-3); line-height: 1.6; margin-top: 18rpx; }
.safe-pad { height: 100rpx; }