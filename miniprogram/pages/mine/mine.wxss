.status-space { width: 100%; }

.topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.topbar .hl { display: flex; align-items: center; gap: 20rpx; }
.logo { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; }
.brand { font-size: 30rpx; font-weight: 800; letter-spacing: 2.8rpx; line-height: 1; color: var(--text); }
.pagename { font-size: 21rpx; font-weight: 600; letter-spacing: 5.2rpx; line-height: 1; color: var(--text-3); margin-top: 10rpx; }
.icbtn { width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(17, 17, 17, .05); }
.icbtn .ic-w { width: 32rpx; height: 32rpx; }
/* 个人头部 */
.mine-hero { position: relative; margin: 24rpx 40rpx 0; height: 232rpx; border-radius: 52rpx; overflow: hidden;
  box-shadow: var(--shadow-card); }
.mh-img { width: 100%; height: 100%; }
.mh-sc { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(90deg, rgba(10,10,12,.90) 0%, rgba(10,10,12,.52) 56%, rgba(10,10,12,.16) 100%); }
.mh-tx { position: absolute; left: 40rpx; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; }
.mh-k { font-size: 21rpx; color: rgba(255,255,255,.72); letter-spacing: .6rpx; }
.mh-n { font-size: 52rpx; font-weight: 800; color: #FFFFFF; margin-top: 12rpx; letter-spacing: 1rpx; }
.mh-d { font-size: 21rpx; color: rgba(255,255,255,.72); margin-top: 12rpx; }

/* 我的兴趣 */
.sect { display: flex; align-items: baseline; justify-content: space-between; padding: 0 40rpx; margin-top: 34rpx; }
.sect .h { font-size: 29rpx; font-weight: 800; letter-spacing: .8rpx; }
.sect .m { font-size: 23rpx; font-weight: 700; color: var(--text-2); }
.icg { margin-top: 20rpx; padding: 0 40rpx 8rpx; white-space: nowrap; }
.c { display: inline-block; width: 148rpx; margin-right: 20rpx; vertical-align: top; }
.c image { width: 148rpx; height: 148rpx; border-radius: 28rpx; background: var(--card-2); }
.c .nm { font-size: 21rpx; font-weight: 700; margin-top: 10rpx; text-align: center; color: var(--text); }
.c.add image { padding: 46rpx; box-sizing: border-box; background: var(--card-2); opacity: .5; }

/* 三宫格 */
.tiles { display: flex; gap: 22rpx; padding: 0 40rpx; margin-top: 34rpx; }
.tile { flex: 1; background: var(--card); border-radius: 40rpx; padding: 28rpx 0; text-align: center;
  box-shadow: var(--shadow-card); }
.tile .n { font-size: 40rpx; font-weight: 800; color: var(--text); line-height: 1; }
.tile .l { font-size: 21rpx; color: var(--text-3); margin-top: 12rpx; }

/* 行组 */
.rows { padding: 0 40rpx; margin-top: 24rpx; }
.cta { display: flex; align-items: center; gap: 18rpx; background: var(--ink); border-radius: 40rpx;
  padding: 26rpx 28rpx; margin-bottom: 20rpx; }
.cta text { flex: 1; font-size: 27rpx; font-weight: 800; color: var(--on-ink); }
.cta-ic { width: 32rpx; height: 32rpx; }
.go-ic { width: 24rpx; height: 24rpx; }
.row { display: flex; align-items: center; gap: 24rpx; background: var(--card); border-radius: 40rpx;
  padding: 26rpx 28rpx; margin-bottom: 20rpx; box-shadow: var(--shadow-card); }
.row .t { flex: 1; font-size: 27rpx; font-weight: 700; color: var(--text); }
.row .rt { font-size: 22rpx; color: var(--text-3); }

/* 深色模式开关 */
.swrow { display: flex; align-items: center; gap: 20rpx; margin: 10rpx 40rpx 0;
  background: var(--card); border-radius: 40rpx; padding: 26rpx 28rpx; box-shadow: var(--shadow-card); }
.sw-ic { width: 34rpx; height: 34rpx; }
.swrow .t { font-size: 27rpx; font-weight: 700; color: var(--text); }
.swrow .rt { margin-left: auto; font-size: 22rpx; color: var(--text-3); }
.sw { width: 88rpx; height: 48rpx; border-radius: 999rpx; background: var(--line-2); position: relative;
  transition: background .2s ease; flex: 0 0 88rpx; }
.sw.on { background: var(--ink); }
.sw .knob { position: absolute; left: 6rpx; top: 6rpx; width: 36rpx; height: 36rpx; border-radius: 50%;
  background: #FFFFFF; transition: transform .2s ease; box-shadow: 0 2rpx 8rpx rgba(0,0,0,.18); }
.sw.on .knob { transform: translateX(40rpx); }

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }
