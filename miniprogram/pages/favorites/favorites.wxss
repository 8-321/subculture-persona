.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .ttl { font-size: 30rpx; font-weight: 800; color: var(--text); }
.navbar .tx { font-size: 25rpx; font-weight: 700; color: var(--text-2); }
.navbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; }
.navbtn image { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

.seg { display: flex; align-items: center; gap: 28rpx; padding: 0 40rpx; margin-top: 24rpx; position: relative; }
.seg .g { font-size: 26rpx; font-weight: 700; color: var(--text-3); padding-bottom: 12rpx; }
.seg .g.on { color: var(--ink); font-weight: 800; border-bottom: 6rpx solid var(--ink); }
.seg .r { position: absolute; right: 40rpx; font-size: 21rpx; color: var(--text-3); }

.list { padding: 0 40rpx; margin-top: 24rpx; }
.row { display: flex; align-items: center; gap: 22rpx; background: var(--card); border-radius: 32rpx;
  padding: 20rpx 24rpx; margin-bottom: 18rpx; box-shadow: var(--shadow-card); }
.th { width: 136rpx; height: 136rpx; border-radius: 24rpx; flex: 0 0 136rpx; background: var(--card-2); }
.tx { flex: 1; min-width: 0; }
.tx .t { font-size: 26rpx; font-weight: 700; color: var(--text); line-height: 1.36; }
.tx .d { font-size: 21rpx; color: var(--text-3); margin-top: 10rpx; }
.bm { width: 64rpx; height: 64rpx; border-radius: 50%; background: var(--card-2); flex: 0 0 64rpx;
  display: flex; align-items: center; justify-content: center; }
.bm image { width: 30rpx; height: 30rpx; }

.grid { display: flex; flex-wrap: wrap; padding: 0 40rpx; margin-top: 28rpx; }
.pd { width: 322rpx; margin-right: 22rpx; margin-bottom: 34rpx; }
.pd:nth-child(2n) { margin-right: 0; }
.pd-im { position: relative; width: 322rpx; height: 322rpx; border-radius: 40rpx; overflow: hidden;
  background: var(--card-2); box-shadow: var(--shadow-card); }
.pd-im image { width: 100%; height: 100%; }
.pd-del { position: absolute; right: 16rpx; top: 16rpx; width: 52rpx; height: 52rpx; border-radius: 50%;
  background: rgba(17,17,20,.62); display: flex; align-items: center; justify-content: center; }
.pd-del image { width: 24rpx; height: 24rpx; }
.pd-bd { font-size: 21rpx; color: var(--text-3); margin-top: 16rpx; }
.pd-nm { font-size: 25rpx; font-weight: 700; margin-top: 6rpx; color: var(--text); }
.pd-pc { font-size: 30rpx; font-weight: 800; margin-top: 8rpx; }

.empty { padding: 120rpx 40rpx; text-align: center; }
.empty .e { font-size: 27rpx; font-weight: 700; color: var(--text-2); }
.empty .s { font-size: 23rpx; color: var(--text-3); margin-top: 16rpx; }
.empty .acts { display: flex; gap: 20rpx; justify-content: center; margin-top: 32rpx; }
.empty .a { height: 76rpx; padding: 0 34rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink);
  font-size: 25rpx; font-weight: 800; display: flex; align-items: center; }

.hint { text-align: center; font-size: 21rpx; color: var(--text-3); margin-top: 24rpx; }
.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }
