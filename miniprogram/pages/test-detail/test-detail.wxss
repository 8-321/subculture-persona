.status-space { width: 100%; }

.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .ttl { font-size: 30rpx; font-weight: 800; letter-spacing: 1rpx; color: var(--text); }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.press { opacity: .82; }

.crumb { padding: 0 40rpx; margin-top: 20rpx; font-size: 21rpx; color: var(--text-3); letter-spacing: .4rpx; }

.cover { position: relative; margin: 20rpx 40rpx 0; height: 340rpx; border-radius: 52rpx; overflow: hidden;
  box-shadow: var(--shadow-card); }
.cover image { width: 100%; height: 100%; }
.cv-sc { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,10,12,.10) 0%, rgba(10,10,12,.30) 60%, rgba(10,10,12,.70) 100%); }
.cover .pill { position: absolute; left: 32rpx; bottom: 30rpx; }

.h1 { padding: 0 40rpx; margin-top: 28rpx; font-size: 54rpx; font-weight: 800; line-height: 1.34;
  letter-spacing: .4rpx; color: var(--text); }
.meta { padding: 0 40rpx; margin-top: 16rpx; font-size: 22rpx; color: var(--text-3); }
.lead { padding: 0 40rpx; margin-top: 20rpx; font-size: 26rpx; line-height: 1.62; color: var(--text-2); }

.card { margin: 30rpx 40rpx 0; background: var(--card); border-radius: 48rpx; padding: 32rpx;
  box-shadow: var(--shadow-card); }
.card .t { font-size: 27rpx; font-weight: 800; margin-bottom: 20rpx; }
.card .li { display: flex; align-items: flex-start; gap: 16rpx; margin-bottom: 16rpx; }
.card .li .dt { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--ink); margin-top: 12rpx; flex: 0 0 12rpx; }
.card .li text { font-size: 25rpx; line-height: 1.5; color: var(--text-2); flex: 1; }
.card .ft { margin-top: 20rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line);
  font-size: 21rpx; color: var(--text-3); }

.note { padding: 0 40rpx; margin-top: 24rpx; font-size: 21rpx; color: var(--text-3); line-height: 1.5; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 24rpx;
  padding: 24rpx 40rpx 48rpx; background: var(--card);
  box-shadow: 0 -8rpx 32rpx rgba(17,17,20,.08); }
.cbtn { width: 104rpx; height: 104rpx; border-radius: 50%; background: var(--card-2);
  display: flex; align-items: center; justify-content: center; flex: 0 0 104rpx; }
.cbtn image { width: 40rpx; height: 40rpx; }
.btn { flex: 1; height: 104rpx; border-radius: 999rpx; background: var(--ink); color: var(--on-ink);
  font-size: 33rpx; font-weight: 800; letter-spacing: .8rpx;
  display: flex; align-items: center; justify-content: center; gap: 14rpx; }
.btn image { width: 32rpx; height: 32rpx; }
.btn.pop { animation: pop .36s cubic-bezier(.2,1.4,.3,1); }
@keyframes pop { from { transform: scale(.94); opacity: .4; } to { transform: scale(1); opacity: 1; } }


.share-btn { padding: 0; margin: 0; line-height: 1; }
.share-btn::after { border: none; }
.press { opacity: .82; }