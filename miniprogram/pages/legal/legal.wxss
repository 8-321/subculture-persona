.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.ttl { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 27rpx; font-weight: 700; letter-spacing: 4rpx; }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.ph { width: 76rpx; height: 76rpx; }
.press { opacity: .82; }

.tabs { display: flex; gap: 14rpx; padding: 22rpx 40rpx 0; }
.tab { padding: 12rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; color: var(--text-2); border: 1rpx solid var(--line); }
.tab.on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); font-weight: 700; }

.head { padding: 36rpx 40rpx 0; }
.kick { font-size: 20rpx; letter-spacing: 3rpx; color: var(--text-3); }
.big { font-family: "Songti SC", "STSong", "Noto Serif SC", serif; font-size: 52rpx; font-weight: 700; margin-top: 10rpx; letter-spacing: 2rpx; }
.date { font-size: 20rpx; color: var(--text-3); margin-top: 12rpx; }

.body { padding: 10rpx 40rpx 0; }
.sec { padding: 30rpx 0 6rpx; border-top: 1rpx solid var(--line); margin-top: 30rpx; }
.sec-h { font-size: 26rpx; font-weight: 800; letter-spacing: 1rpx; }
.p { font-size: 24rpx; line-height: 1.82; color: var(--text-2); margin-top: 14rpx; }

.contract { margin-top: 34rpx; padding: 24rpx 24rpx; border-radius: 28rpx; display: flex; align-items: center; gap: 12rpx;
  background: var(--card); border: 1rpx solid var(--line); font-size: 23rpx; font-weight: 700; }
.ct-ic { width: 26rpx; height: 26rpx; }
.ct-go { width: 22rpx; height: 22rpx; margin-left: auto; }

.contact { margin-top: 34rpx; padding: 28rpx 26rpx; background: var(--card-2); border-left: 4rpx solid var(--ink); }
.ct-h { font-size: 24rpx; font-weight: 800; }
.ct-p { font-size: 21rpx; color: var(--text-3); margin-top: 14rpx; }
.ct-mail { font-size: 26rpx; font-weight: 700; margin-top: 8rpx; text-decoration: underline; }
.ct-mail.off { font-size: 22rpx; color: var(--text-3); text-decoration: none; }
.safe-pad { height: 120rpx; }