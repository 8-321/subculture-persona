.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .rt { font-size: 23rpx; font-weight: 700; color: var(--text-3); }
.navbtn { width: 72rpx; height: 72rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 72rpx; }
.navbtn image { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

.big { padding: 0 40rpx; margin-top: 48rpx; font-size: 46rpx; font-weight: 800; line-height: 1.34; color: var(--text); }
.sub { padding: 0 40rpx; margin-top: 18rpx; font-size: 25rpx; color: var(--text-2); }

.icg { display: flex; flex-wrap: wrap; gap: 20rpx; padding: 0 40rpx; margin-top: 32rpx; }
.c { width: 322rpx; }
.c:nth-child(2n) { margin-right: 0; }
.c .im { position: relative; width: 322rpx; height: 242rpx; border-radius: 28rpx; overflow: hidden;
  background: var(--card-2); border: 6rpx solid transparent; box-sizing: border-box; }
.c.on .im { border-color: var(--ink); }
.c .im image { width: 100%; height: 100%; }
.c .ck { position: absolute; right: 16rpx; top: 16rpx; width: 48rpx; height: 48rpx; border-radius: 50%;
  background: var(--ink); display: flex; align-items: center; justify-content: center;
  animation: pop .26s cubic-bezier(.2,1.5,.4,1); }
.c .ck image { width: 26rpx; height: 26rpx; }
@keyframes pop { 0% { transform: scale(0); } 60% { transform: scale(1.16); } 100% { transform: scale(1); } }
.c .nm { text-align: center; font-size: 24rpx; font-weight: 700; margin-top: 12rpx; color: var(--text); }
.c.on .nm { font-weight: 800; }

.more { display: flex; align-items: center; justify-content: center; gap: 8rpx;
  font-size: 23rpx; color: var(--text-3); margin-top: 28rpx; }
.more image { width: 22rpx; height: 22rpx; }

.cta { margin: 32rpx 40rpx 0; height: 104rpx; border-radius: 999rpx; background: var(--ink);
  color: var(--on-ink); font-size: 31rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; }
.cta.off { opacity: .38; }
