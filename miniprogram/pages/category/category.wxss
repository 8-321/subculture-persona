.status-space { width: 100%; }
.navbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.navbar .ttl { font-size: 30rpx; font-weight: 800; letter-spacing: 1rpx; color: var(--text); }
.navbtn { width: 76rpx; height: 76rpx; border-radius: 50%; background: var(--card);
  border: 1rpx solid var(--line-2); display: flex; align-items: center; justify-content: center; flex: 0 0 76rpx; }
.navbtn image { width: 34rpx; height: 34rpx; }
.press { opacity: .82; }

.body { display: flex; margin-top: 16rpx; }
.rail { width: 180rpx; flex: 0 0 180rpx; background: var(--card-2); }
.ri { height: 92rpx; display: flex; align-items: center; justify-content: center;
  font-size: 25rpx; font-weight: 700; color: var(--text-2); position: relative; }
.ri.on { background: var(--ink); color: var(--on-ink); font-weight: 800; }

.pane { flex: 1; min-width: 0; padding: 0 24rpx; box-sizing: border-box; }
.subcats { white-space: nowrap; padding: 20rpx 0 8rpx;
  -webkit-mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%);
  mask-image: linear-gradient(90deg, #000 0, #000 88%, transparent 100%); }
.sc { display: inline-block; height: 60rpx; line-height: 60rpx; padding: 0 24rpx; border-radius: 999rpx;
  background: var(--card); color: var(--text-2); font-size: 23rpx; font-weight: 700; margin-right: 16rpx;
  border: 1rpx solid var(--line); }
.sc.on { background: var(--ink); color: var(--on-ink); border-color: var(--ink); }

.frow { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 0 16rpx; }
.frow .cnt { font-size: 21rpx; color: var(--text-3); }
.frow .flt { display: flex; align-items: center; gap: 8rpx; font-size: 23rpx; font-weight: 700; color: var(--text-2); }
.frow .flt image { width: 24rpx; height: 24rpx; }
.frow .flt.has { color: var(--ink); font-weight: 800; }
.frow .flt.press { transform: scale(.94); }
.flt-n {
  min-width: 28rpx; height: 28rpx; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink);
  font-size: 18rpx; font-weight: 800;
  display: flex; align-items: center; justify-content: center; padding: 0 8rpx;
}

/* 已选条件条 */
.chosen { display: flex; gap: 14rpx; padding: 0 0 18rpx; overflow-x: auto; white-space: nowrap; }
.chosen::-webkit-scrollbar { display: none; }
.ci {
  flex: 0 0 auto;
  display: inline-flex; align-items: center; gap: 10rpx;
  height: 56rpx; padding: 0 20rpx; border-radius: 999rpx;
  background: var(--ink); color: var(--on-ink);
  font-size: 22rpx; font-weight: 700;
}
.ci-x { width: 20rpx; height: 20rpx; opacity: .85; }
.ci.cl { background: transparent; color: var(--text-3); border: 1rpx solid var(--line-2); }

.cat-note { margin: 0 0 16rpx; }
.cgrid { display: flex; flex-wrap: wrap; }
.cc { width: 48%; margin-right: 4%; margin-bottom: 26rpx; }
.cc:nth-child(2n) { margin-right: 0; }
.cc .im { width: 100%; height: 220rpx; border-radius: 28rpx; overflow: hidden; background: var(--card-2);
  box-shadow: var(--shadow-card); }
.cc .im image { width: 100%; height: 100%; }
.cc .ct { font-size: 24rpx; font-weight: 700; margin-top: 14rpx; line-height: 1.34; color: var(--text);
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.cc .cm { display: flex; align-items: center; gap: 10rpx; margin-top: 10rpx; }
.cc .nm2 { font-size: 20rpx; color: var(--text-2); flex: 1; overflow: hidden; white-space: nowrap; }
.cc .lk { font-size: 20rpx; color: var(--text-3); }

.empty { padding: 120rpx 0; text-align: center; }
.empty .e { font-size: 26rpx; font-weight: 700; color: var(--text-2); }
.empty .s { font-size: 22rpx; color: var(--text-3); margin-top: 14rpx; }

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }
