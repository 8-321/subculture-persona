.status-space { width: 100%; }

/* 页头 */
.topbar { display: flex; align-items: center; justify-content: space-between; padding: 0 40rpx; margin-top: 8rpx; }
.topbar .hl { display: flex; align-items: center; gap: 20rpx; }
.topbar .logo { width: 72rpx; height: 72rpx; flex: 0 0 72rpx; }
.topbar .brand { font-size: 30rpx; font-weight: 800; letter-spacing: 2.8rpx; line-height: 1; color: var(--text); }
.topbar .pagename { font-size: 21rpx; font-weight: 600; letter-spacing: 5.2rpx; line-height: 1; color: var(--text-3); margin-top: 10rpx; }
.topbar .act { display: flex; align-items: center; gap: 16rpx; }
.authbtn {
  height: 64rpx; padding: 0 26rpx; border-radius: 999rpx;
  background: var(--card); border: 1rpx solid var(--line-2);
  font-size: 25rpx; font-weight: 700; color: var(--text);
  display: flex; align-items: center;
}
.hi-av { width: 68rpx; height: 68rpx; border-radius: 50%; border: 1rpx solid var(--line); }
.icbtn { width: 68rpx; height: 68rpx; border-radius: 50%;
  background: var(--card); border: 1rpx solid var(--line);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 10rpx rgba(17, 17, 17, .05); }
.icbtn .ic-w { width: 32rpx; height: 32rpx; }
.press { opacity: .82; }

/* 主视觉 */
.hero { height: 456rpx; margin: 24rpx 40rpx 0; }
.hero-in { position: relative; width: 100%; height: 100%; border-radius: 52rpx; overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(17, 17, 20, .10); }
.hero-img { width: 100%; height: 100%; }
.hero-scrim { position: absolute; left: 0; right: 0; top: 0; bottom: 0;
  background: linear-gradient(180deg, rgba(10,10,12,.30) 0%, rgba(10,10,12,0) 26%, rgba(10,10,12,.10) 52%, rgba(10,10,12,.78) 82%, rgba(10,10,12,.92) 100%); }
.hero-body { position: absolute; left: 48rpx; right: 48rpx; bottom: 50rpx; }
.hero-t { font-size: 44rpx; font-weight: 800; letter-spacing: .4rpx; line-height: 1.3; color: #FFFFFF; margin-top: 24rpx; white-space: pre-wrap; }
.hero-s { font-size: 22rpx; color: rgba(255,255,255,.72); margin-top: 16rpx; letter-spacing: .4rpx; }
.hero-cta {
  display: inline-flex; align-items: center; gap: 18rpx; height: 88rpx; padding: 0 44rpx;
  border-radius: 999rpx; background: #FFFFFF; color: #141418;
  font-size: 29rpx; font-weight: 800; letter-spacing: .8rpx; margin-top: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(0,0,0,.22);
}
.cta-ic { width: 32rpx; height: 32rpx; }

/* 轮播点：5px 圆 ↔ 16×5 胶囊 */
.dots { display: flex; gap: 12rpx; align-items: center; justify-content: center; margin-top: 20rpx; }
.dots .dot { width: 10rpx; height: 10rpx; border-radius: 999rpx; background: rgba(130,130,140,.36); transition: width .2s ease; }
.dots .dot.on { width: 32rpx; background: var(--ink); }

/* 继续上次（断点续答） */
.resume {
  display: flex; align-items: center; gap: 24rpx;
  margin: 32rpx 40rpx 0; padding: 28rpx 32rpx;
  border-radius: 40rpx;
  background: var(--card); box-shadow: var(--shadow-card);
  transition: transform 260ms cubic-bezier(.34, 1.56, .64, 1);
}
.resume.press { transform: scale(.98); }
.rs-l { flex: 1; min-width: 0; }
.rs-k { font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; color: var(--text-3); }
.rs-t {
  font-size: 29rpx; font-weight: 800; color: var(--text); margin-top: 10rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.rs-b { font-size: 22rpx; color: var(--text-2); margin-top: 10rpx; }
.rs-ring { flex: 0 0 140rpx; }
.rs-bar {
  width: 140rpx; height: 10rpx; border-radius: 999rpx;
  background: var(--card-2); overflow: hidden;
}
.rs-fill {
  height: 100%; background: var(--ink); border-radius: 999rpx;
  transition: width .8s cubic-bezier(.22, 1, .36, 1);
}
.rs-ic { width: 28rpx; height: 28rpx; flex: 0 0 28rpx; }

/* 推荐品类 */
/* 推荐品类：整块卡片，2×2 网格 */
.recblock {
  margin: 28rpx 40rpx 0; padding: 26rpx 24rpx 24rpx;
  background: var(--card); border: 1rpx solid var(--line-2);
  border-radius: 40rpx; box-shadow: var(--shadow-card);
}
.recsect { display: flex; align-items: center; justify-content: space-between; padding: 0 4rpx; }
.recsect .st { font-size: 29rpx; font-weight: 800; letter-spacing: .8rpx; }
.recsect .lnk { display: flex; align-items: center; gap: 6rpx; font-size: 23rpx; font-weight: 700; color: var(--text-2); }
.lnk-ic { width: 24rpx; height: 24rpx; }
.recgrid { display: flex; flex-wrap: wrap; justify-content: space-between; margin-top: 6rpx; }
.rc { width: calc(50% - 10rpx); margin-top: 20rpx; }
.rc-press { opacity: .9; }
.rc-im { position: relative; width: 100%; height: 208rpx; border-radius: 26rpx; overflow: hidden; background: var(--card-2); }
.rc-im image { width: 100%; height: 100%; }
.rk { position: absolute; left: 12rpx; top: 12rpx; height: 32rpx; min-width: 46rpx; padding: 0 10rpx;
  border-radius: 16rpx; background: rgba(17,17,20,.86); color: #FFFFFF;
  font-size: 17rpx; font-weight: 800; letter-spacing: 1rpx;
  display: flex; align-items: center; justify-content: center; }
.rc-n { font-size: 25rpx; font-weight: 700; letter-spacing: .6rpx; margin-top: 12rpx; padding: 0 4rpx; }

/* 更多亚文化测试 */
.sect { padding: 0 40rpx; margin-top: 30rpx; }
.sect .hd { display: flex; align-items: baseline; justify-content: space-between; }
.sect .hd .t { font-size: 29rpx; font-weight: 800; letter-spacing: .8rpx; }
.sect .hd .m { font-size: 23rpx; color: var(--text-3); display: flex; align-items: center; gap: 6rpx; }
.railbox { position: relative; margin: 24rpx -40rpx 0; }
.railbox.sm { margin-top: 20rpx; }
.railbox::after {
  content: ''; position: absolute; top: 0; right: 0; bottom: 8rpx; width: 64rpx;
  z-index: 2; pointer-events: none;
  background: linear-gradient(90deg, rgba(0,0,0,0) 0%, var(--bg) 86%);
}
.rail { margin: 0; padding: 0 40rpx 8rpx; white-space: nowrap; }
.tg { display: inline-block; width: 264rpx; margin-right: 24rpx; vertical-align: top; }
.tg-im { width: 100%; height: 264rpx; border-radius: 28rpx; overflow: hidden; background: var(--card-2);
  box-shadow: 0 8rpx 28rpx rgba(17,17,20,.07); }
.tg-im image { width: 100%; height: 100%; }
.tg-a { font-size: 23rpx; font-weight: 700; letter-spacing: .2rpx; line-height: 1.34; margin-top: 12rpx;
  color: var(--text); white-space: normal; }
.tg-b { font-size: 20rpx; color: var(--text-3); margin-top: 8rpx; white-space: nowrap; }

/* 最近看过（小卡横滑） */
.rail.sm { margin-top: 0; }
.rg { display: inline-block; width: 160rpx; margin-right: 20rpx; vertical-align: top; }
.rg-im {
  width: 160rpx; height: 160rpx; border-radius: 28rpx;
  background: var(--card-2); box-shadow: 0 6rpx 20rpx rgba(17, 17, 20, .07);
}
.rg-n {
  font-size: 21rpx; font-weight: 700; color: var(--text); margin-top: 10rpx;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* 按压态：配合 m-tilt / m-glare */
.press { opacity: .92; }

.fade-bottom.dk { background: linear-gradient(180deg, rgba(14,14,17,0) 0%, rgba(14,14,17,.86) 66%, rgba(14,14,17,1) 88%); }
