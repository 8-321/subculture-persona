<view class="pg {{dark ? 'theme-dark' : ''}} {{reduce ? 'reduce-motion' : ''}} {{tr}}">
  <view class="status-space" style="height:{{sbh}}px"></view>

  <!-- 页头：品牌扫光 + 建档 / 搜索 -->
  <view class="topbar capr" style="padding-right:{{capR}}px">
    <view class="hl">
      <image class="logo" src="{{dark ? '/images/ic/logo-white.png' : '/images/ic/logo-ink.png'}}" mode="aspectFit" />
      <view class="bt">
        <view class="brand m-shine">第二文化</view>
        <view class="pagename">首页</view>
      </view>
    </view>
    <view class="act">
      <view wx:if="{{!user}}" class="authbtn" bindtap="onAuth" hover-class="press">建立档案</view>
      <view wx:else class="hi" bindtap="onMine">
        <image class="hi-av" src="{{user.avatar || '/images/ui/p-punk.jpg'}}" mode="aspectFill" />
      </view>
      <view class="icbtn" bindtap="onSearch" hover-class="press">
        <image class="ic-w" src="{{dark ? '/images/ic/search-white.png' : '/images/ic/search-ink.png'}}" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 主视觉：图片 Ken Burns 缓慢推近 + 文字逐行模糊上浮 -->
  <swiper class="hero" current="{{cur}}" duration="500" bindchange="onSwipe" bindtouchstart="onTouch">
    <swiper-item wx:for="{{slides}}" wx:key="id">
      <view class="hero-in">
        <image class="hero-img {{cur === index ? 'm-kenburns' : ''}}" src="{{item.img}}" mode="aspectFill" />
        <view class="hero-scrim"></view>
        <view class="hero-body">
          <view class="pill {{cur === index ? 'm-rise' : ''}}" style="animation-delay:40ms">
            <view class="dot"></view>{{item.pill}}
          </view>
          <view class="hero-t {{cur === index ? 'm-blur' : ''}}" style="animation-delay:120ms">{{item.title}}</view>
          <view class="hero-s {{cur === index ? 'm-rise' : ''}}" style="animation-delay:260ms">{{item.sub}}</view>
          <view class="hero-cta {{cur === index ? 'm-pop' : ''}}" style="animation-delay:380ms"
                bindtap="onHero" data-target="{{item.target}}" hover-class="press">
            {{item.cta}}
            <image class="cta-ic" src="/images/ic/fwd-ink.png" mode="aspectFit" />
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <view class="dots">
    <view wx:for="{{slides}}" wx:key="id" class="dot {{cur === index ? 'on' : ''}}"></view>
  </view>

  <!-- 继续上次：有答题进度才出现（断点续答） -->
  <view wx:if="{{resume}}" class="resume m-rise-lg" bindtap="onResume" hover-class="press">
    <view class="rs-l">
      <view class="rs-k">继续上次</view>
      <view class="rs-t">{{resume.title}}</view>
      <view class="rs-b">已答 {{resume.done}} 题 · 剩 {{resume.left}} 题</view>
    </view>
    <view class="rs-ring">
      <view class="rs-bar"><view class="rs-fill" style="width:{{resume.pct}}%"></view></view>
    </view>
    <image class="rs-ic" src="/images/ic/fwd-{{dark ? 'white' : 'ink'}}.png" mode="aspectFit" />
  </view>

  <!-- 推荐品类：四格一框，整块有边，避免横滑把第四格切掉 -->
  <view class="recblock">
    <view class="recsect">
      <view class="st">推荐品类</view>
      <view class="lnk" bindtap="onCategory">
        查看全部
        <image class="lnk-ic" src="{{dark ? '/images/ic/fwd-white.png' : '/images/ic/fwd-ink.png'}}" mode="aspectFit" />
      </view>
    </view>
    <view class="recgrid">
      <view
        class="rc m-pop m-st"
        style="animation-delay:{{item._d}}ms"
        wx:for="{{recCatsView}}"
        wx:key="id"
        bindtap="onType"
        data-code="{{item.code}}"
        hover-class="rc-press"
      >
        <view class="rc-im m-glare">
          <image src="{{item.img}}" mode="aspectFill" />
          <view class="rk">{{item.no}}</view>
        </view>
        <view class="rc-n">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 最近看过 -->
  <view wx:if="{{recent.length > 0}}" class="sect">
    <view class="hd">
      <view class="t">最近看过</view>
      <view class="m" bindtap="onHistory">
        全部
        <image class="lnk-ic" src="{{dark ? '/images/ic/fwd-white.png' : '/images/ic/fwd-ink.png'}}" mode="aspectFit" />
      </view>
    </view>
    <view class="railbox sm">
    <scroll-view class="rail sm" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        class="rg m-pop m-st"
        style="animation-delay:{{item._d}}ms"
        wx:for="{{recent}}"
        wx:key="id"
        bindtap="onRecent"
        data-id="{{item.id}}"
        data-type="{{item.type}}"
        data-src="{{item.src}}"
      >
        <image class="rg-im" src="{{item.img}}" mode="aspectFill" />
        <view class="rg-n">{{item.title}}</view>
      </view>
    </scroll-view>
    </view>
  </view>

  <!-- 更多亚文化测试 -->
  <view class="sect">
    <view class="hd">
      <view class="t">更多亚文化测试</view>
      <view class="m" bindtap="onAllTests">
        全部
        <image class="lnk-ic" src="{{dark ? '/images/ic/fwd-white.png' : '/images/ic/fwd-ink.png'}}" mode="aspectFit" />
      </view>
    </view>
    <view class="railbox">
    <scroll-view class="rail" scroll-x enable-flex show-scrollbar="{{false}}">
      <view
        class="tg m-pop m-st"
        style="animation-delay:{{item._d}}ms"
        wx:for="{{testsView}}"
        wx:key="id"
        bindtap="onTest"
        data-id="{{item.id}}"
      >
        <view class="tg-im m-tilt m-glare" hover-class="press">
          <image src="{{item.img}}" mode="aspectFill" />
        </view>
        <view class="tg-a">{{item.title}}</view>
        <view class="tg-b">{{item.qcount}} 题 · {{item.minutes}} 分钟</view>
      </view>
    </scroll-view>
    </view>
  </view>

  <view class="safe-pad"></view>

  <view class="spark-layer">
    <view
      class="spark"
      wx:for="{{sparks}}"
      wx:key="id"
      style="left:{{item.x}}px;top:{{item.y}}px;--sx:{{item.sx}}px;--sy:{{item.sy}}px;transform:scale({{item.s}})"
    ></view>
  </view>
</view>
<view class="fade-bottom {{dark ? 'dk' : ''}}"></view>
