/* 悬浮胶囊 Tab 栏：left/right 32rpx · bottom 32rpx · 高 120rpx（设计 16/16/60） */
.tabbar {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  height: 120rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  z-index: 999;
  background: rgba(255, 255, 255, .92);
  backdrop-filter: blur(44rpx) saturate(1.6);
  border: 1rpx solid rgba(17, 17, 20, .075);
  box-shadow: 0 24rpx 68rpx rgba(17, 17, 20, .16);
  box-sizing: border-box;
}
.tabbar.dk {
  background: rgba(23, 23, 27, .92);
  border-color: rgba(255, 255, 255, .10);
  box-shadow: 0 24rpx 68rpx rgba(0, 0, 0, .5);
}
.tb {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
  color: #8A8A93;
}
.tb .ic {
  width: 38rpx;
  height: 38rpx;
}
.tb .lb {
  white-space: nowrap;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: .2rpx;
  line-height: 1.2;
  color: #8A8A93;
}
.tb.on .lb {
  color: #141418;
  font-weight: 800;
}
.tb.on::after {
  content: "";
  position: absolute;
  bottom: 14rpx;
  width: 36rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #141418;
}
.tabbar.dk .tb.on .lb { color: #F5F5F7; }
.tabbar.dk .tb.on::after { background: #F5F5F7; }
.press { opacity: .8; }
